{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://onelink.to/3yts3h"
    },
    {
      "source": "/organizer",
      "destination": "https://organizer.calt.gr",
      "permanent": false
    },
    {
      "source": "/organizer.html",
      "destination": "https://organizer.calt.gr",
      "permanent": false
    },
    {
      "source": "/el/organizer",
      "destination": "https://organizer.calt.gr",
      "permanent": false
    },
    {
      "source": "/el/organizer.html",
      "destination": "https://organizer.calt.gr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/el/:path*",
      "destination": "/el/:path*"
    },
    {
      "source": "/events/:id",
      "destination": "https://calt-web-app.vercel.app/events/:id"
    },
    {
      "source": "/c/:slug",
      "destination": "https://calt-web-app.vercel.app/c/:slug"
    },
    {
      "source": "/app-assets/:path*",
      "destination": "https://calt-web-app.vercel.app/app-assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.calt.gr/:path*"
    }
  ]
}